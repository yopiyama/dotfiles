(version 1)
(allow default)

; ファイル名で指定した機密ファイルの内容の読み取り・変更を全子プロセスで拒否する。
; metadata は許可するため、ディレクトリ一覧や通常ファイルの検索は利用できる。
(deny file-read-data file-write*
  (regex #"(^|/)([.]env[^/]*|[^/]*[.]env|id_[^/]*|[^/]*[.]pem|[^/]*[.]key)($|/)"))

; 実行中のエージェントから、この保護の定義と読み込み済み拡張を変更させない。
(deny file-write*
  (regex #"/[.]omp/agent/extensions/safety[.]ts$"
         #"/[.]config/omp/(safety[.]ts|secrets[.]sb)$"))
