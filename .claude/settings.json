{
    "agentPushNotifEnabled": true,
    "attribution": {
        "pr": "🤖 Generated with [Claude Code](https://claude.com/claude-code)"
    },
    "editorMode": "vim",
    "effortLevel": "high",
    "enableAllProjectMcpServers": true,
    "enabledPlugins": {
        "crit@crit": true,
        "ponytail@ponytail": true
    },
    "env": {
        "CLAUDE_CODE_DISABLE_MOUSE_CLICKS": "1"
    },
    "extraKnownMarketplaces": {
        "crit": {
            "source": {
                "repo": "tomasz-tomczyk/crit",
                "source": "github"
            }
        },
        "ponytail": {
            "source": {
                "repo": "DietrichGebert/ponytail",
                "source": "github"
            }
        }
    },
    "hooks": {
        "PostToolUse": [
            {
                "hooks": [
                    {
                        "command": "~/.claude/hooks/sync-tasks-to-obsidian.sh",
                        "type": "command"
                    }
                ],
                "matcher": "TaskCreate|TaskUpdate"
            }
        ],
        "PreToolUse": [
            {
                "hooks": [
                    {
                        "command": "~/.claude/hooks/allow-safe-pipes.sh",
                        "type": "command"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "command": "~/.claude/hooks/git-guard.sh",
                        "type": "command"
                    }
                ],
                "matcher": "Bash"
            },
            {
                "hooks": [
                    {
                        "command": "~/.claude/hooks/id-guard.sh",
                        "type": "command"
                    }
                ],
                "matcher": "Write|Edit|Bash|mcp__notion__.*"
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "command": "~/.claude/hooks/log-to-obsidian.sh",
                        "type": "command"
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "command": "~/.claude/hooks/log-to-obsidian.sh",
                        "type": "command"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "command": "~/.claude/hooks/obsidian-skill-reminder.sh",
                        "type": "command"
                    }
                ]
            }
        ]
    },
    "inputNeededNotifEnabled": true,
    "model": "opus",
    "permissions": {
        "allow": [
            "Bash(awk:*)",
            "Bash(cat:*)",
            "Bash(cut:*)",
            "Bash(date:*)",
