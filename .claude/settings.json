            "Bash(uname:*)",
            "Bash(uniq:*)",
            "Bash(wc:*)",
            "Bash(which:*)",
            "Bash(~/.claude/skills/code-review/scripts/codex-review.sh:*)",
            "Bash(~/.claude/skills/code-review/scripts/check-prereqs.sh:*)",
            "Bash(~/.claude/skills/pr-comments/scripts/fetch-pr-comments.sh:*)",
            "Bash(codex:*)",
            "Bash(whoami:*)",
            "mcp__context7__get-library-docs",
            "mcp__context7__resolve-library-id",
            "Edit(**)",
            "Read(**)",
            "Write(**)",
            "Read(//tmp/**)",
            "Edit(//tmp/**)",
            "Write(//tmp/**)",
            "Read(//private/tmp/**)",
            "Edit(//private/tmp/**)",
            "Write(//private/tmp/**)",
            "Read(~/.claude/**)",
            "Read(~/ghq/github.com/yopiyama/dotfiles/.claude/**)"
        ],
        "deny": [
            "Bash(curl:*)",
            "Bash(find * -delete*)",
            "Bash(find * -exec*)",
            "Bash(find * -execdir*)",
            "Bash(find * -iwholename*/*)",
            "Bash(find * -ok*)",
            "Bash(find *|*xargs *)",
            "Bash(git clean:*)",
            "Bash(git config:*)",
            "Bash(git filter-branch:*)",
            "Bash(git revert:*)",
            "Bash(gh pr merge:*)",
            "Bash(gh pr close:*)",
            "Bash(git switch:*)",
            "Bash(git update-ref:*)",
            "Bash(perl -pi:*)",
            "Bash(rm -rf:*)",
            "Bash(sed -i:*)",
            "Bash(sudo:*)",
            "Bash(tee:*)",
            "Bash(wget:*)",
            "Bash(xargs:*)",
            "Read(.env*)",
            "Bash(cat *.env*)",
            "Read(**/id_*)",
            "Edit(**/id_*)",
            "Write(**/id_*)",
            "Read(**/*.pem)",
            "Edit(**/*.pem)",
            "Write(**/*.pem)",
            "Read(**/*.key)",
            "Edit(**/*.key)",
            "Write(**/*.key)",
            "Read(**/*.env)",
            "Edit(**/*.env)",
            "Write(**/*.env)",
            "Write(.env*)"
        ],
        "ask": [
            "Bash(git push:*)",
            "Bash(git reset:*)"
        ],
        "defaultMode": "default"
    },
    "model": "claude-fable-5[1m]",
    "enableAllProjectMcpServers": true,
    "hooks": {
        "PreToolUse": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/hooks/allow-safe-pipes.sh"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/hooks/git-guard.sh"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "TaskCreate|TaskUpdate",
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/hooks/sync-tasks-to-obsidian.sh"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/hooks/obsidian-skill-reminder.sh"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/hooks/log-to-obsidian.sh"
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/hooks/log-to-obsidian.sh"
                    }
                ]
            }
        ]
    },
    "statusLine": {
        "type": "command",
        "command": "bash ~/.claude/hooks/statusline.sh"
    },
    "effortLevel": "high",
    "tui": "fullscreen",
    "showThinkingSummaries": true,
    "theme": "dark",
    "editorMode": "vim",
    "preferredNotifChannel": "terminal_bell",
    "inputNeededNotifEnabled": true
}
