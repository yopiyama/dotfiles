            "Bash(~/.claude/skills/connect-obsidian/scripts/obs.sh help:*)",
            "Bash(~/.claude/skills/connect-obsidian/scripts/obs.sh cli-help:*)",
            "Bash(~/.claude/skills/connect-obsidian/scripts/obs.sh --help)",
            "Bash(codex:*)",
            "Bash(whoami:*)",
            "mcp__context7__get-library-docs",
            "mcp__context7__resolve-library-id",
            "Edit(**)",
            "Read(**)",
            "Read(//tmp/**)",
            "Edit(//tmp/**)",
            "Read(//private/tmp/**)",
            "Edit(//private/tmp/**)",
            "Read(~/.claude/**)",
            "Read(~/ghq/github.com/yopiyama/dotfiles/.claude/**)",
            "Bash(obsidian --help)",
            "Skill(*)",
            "Bash(crit:*)"
        ],
        "ask": [
            "Bash(git push:*)",
            "Bash(git reset:*)"
        ],
        "defaultMode": "auto",
        "deny": [
            "Bash(curl:*)",
            "Bash(find * -delete*)",
            "Bash(find * -exec*)",
            "Bash(find * -execdir*)",
            "Bash(find * -iwholename*/*)",
            "Bash(find * -ok*)",
            "Bash(find *|*xargs *)",
            "Bash(git clean:*)",
            "Bash(git config:*)",
            "Bash(git filter-branch:*)",
            "Bash(git revert:*)",
            "Bash(gh pr merge:*)",
            "Bash(gh pr close:*)",
            "Bash(git update-ref:*)",
            "Bash(perl -pi:*)",
            "Bash(rm -rf:*)",
            "Bash(sed -i:*)",
            "Bash(sudo:*)",
            "Bash(tee:*)",
            "Bash(wget:*)",
            "Bash(xargs:*)",
            "Read(.env*)",
            "Edit(.env*)",
            "Bash(cat *.env*)",
            "Read(**/id_*)",
            "Edit(**/id_*)",
            "Read(**/*.pem)",
            "Edit(**/*.pem)",
            "Read(**/*.key)",
            "Edit(**/*.key)",
            "Read(**/*.env)",
            "Edit(**/*.env)"
        ]
    },
    "preferredNotifChannel": "terminal_bell",
    "showThinkingSummaries": true,
    "statusLine": {
        "command": "bash ~/.claude/hooks/statusline.sh",
        "type": "command"
    },
    "theme": "dark",
    "tui": "fullscreen"
}
