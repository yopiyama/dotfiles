{
  "manifest_version": 3,
  "name": "Google Calendar Presets",
  "version": "1.0.4",
  "description": "Google Calendar の複数カレンダーをプリセット単位で表示・非表示切り替えします。",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["https://calendar.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Calendar Presets"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-active-preset": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "MacCtrl+Shift+9"
      },
      "description": "アクティブなカレンダープリセットを切り替える"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
